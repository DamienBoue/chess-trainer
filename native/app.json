{
  "expo": {
    "name": "Chess Trainer",
    "slug": "chess-trainer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chesstrainer",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.damienboue.chesstrainer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#769656",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.damienboue.chesstrainer",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1a1a1a",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/chess-trainer"
    },
    "extra": {
      "eas": {
        "projectId": "e02b939f-c51d-457a-9663-3e12f4f658b3"
      }
    },
    "owner": "damienboue",
    "updates": {
      "url": "https://u.expo.dev/e02b939f-c51d-457a-9663-3e12f4f658b3",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
